  "body_html": "<link rel=\"canonical\" href=\"[問卷頁面正式網址，例如 https://www.matrix.com.tw/x1-metal-survey]\">\n<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"Product\",\n  \"name\": \"Matrix X1 METAL 等離子便攜式電動磨豆機\",\n  \"image\": \"https://img.1shop.tw/dmLqpoYEVREYo9xRbZy2XK7l/a1A4ovQm3KXP8GQLlDxz6OWE/original.jpg\",\n  \"description\": \"金屬機身便攜式電動磨豆機，搭載等離子技術降低咖啡粉結塊與靜電飛粉，75 段研磨刻度，涵蓋義式、摩卡壺、手沖到法式濾壓。內建 1800mAh 鋰電池、Type-C 充電。\",\n  \"brand\": {\n    \"@type\": \"Brand\",\n    \"name\": \"Matrix\"\n  },\n  \"category\": \"咖啡磨豆機\",\n  \"offers\": {\n    \"@type\": \"Offer\",\n    \"availability\": \"https://schema.org/PreOrder\",\n    \"priceCurrency\": \"TWD\",\n    \"url\": \"[問卷頁面正式網址]\"\n  }\n}\n</script>\n<style>\n  body {\n    font-family: \"Microsoft JhengHei\", Arial, sans-serif;\n    background-color: #ffffff;\n    color: #222222;\n    margin: 0;\n    padding: 0;\n    line-height: 1.7;\n  }\n  .container {\n    max-width: 700px;\n    margin: 0 auto;\n    background: #ffffff;\n  }\n  h1, h2 {\n    color: #000000;\n    text-align: center;\n  }\n  h1 {\n    font-size: 24px;\n    font-weight: 700;\n    margin: 32px 0 12px;\n  }\n  h2 {\n    font-size: 20px;\n    margin-top: 28px;\n  }\n  p {\n    margin: 12px 24px;\n  }\n  .hero {\n    width: 100%;\n  }\n  .figure {\n    display: block;\n    width: 88%;\n    max-width: 460px;\n    margin: 18px auto 6px;\n    border-radius: 8px;\n  }\n  .figure-cap {\n    text-align: center;\n    font-size: 13px;\n    color: #888888;\n    margin: 0 24px 4px;\n  }\n  .lead {\n    text-align: center;\n    font-weight: 500;\n  }\n  .section-gray {\n    background-color: #f6f6f6;\n    padding: 16px 0;\n  }\n\n  /* ── 問卷區塊 ── */\n  .q-block {\n    margin: 0 24px 4px;\n    padding: 22px 0;\n    border-bottom: 1px solid #eeeeee;\n  }\n  .q-num {\n    display: inline-block;\n    background-color: #000000;\n    color: #ffffff;\n    font-size: 13px;\n    font-weight: 700;\n    padding: 2px 10px;\n    border-radius: 4px;\n    margin-bottom: 8px;\n  }\n  .q-title {\n    font-size: 16px;\n    font-weight: 700;\n    color: #000000;\n    margin: 0 0 4px;\n  }\n  .q-note {\n    font-size: 13px;\n    color: #888888;\n    margin: 0 0 14px;\n  }\n  .opt {\n    display: flex;\n    align-items: center;\n    margin: 8px 0;\n    font-size: 15px;\n  }\n  .opt input[type=\"radio\"],\n  .opt input[type=\"checkbox\"] {\n    margin-right: 10px;\n    accent-color: #000000;\n    width: 16px;\n    height: 16px;\n    flex-shrink: 0;\n  }\n  .opt label { cursor: pointer; }\n  textarea, input[type=\"text\"], input[type=\"email\"] {\n    width: 100%;\n    box-sizing: border-box;\n    margin-top: 6px;\n    padding: 10px 12px;\n    border: 1px solid #cccccc;\n    border-radius: 6px;\n    font-family: inherit;\n    font-size: 14px;\n  }\n  textarea:focus, input[type=\"text\"]:focus, input[type=\"email\"]:focus {\n    outline: none;\n    border-color: #d4af37;\n  }\n  .inline-text { width: auto; flex: 1; margin-top: 0; margin-left: 8px; }\n\n  /* 1–5 量表 */\n  .scale {\n    display: flex;\n    justify-content: space-between;\n    gap: 6px;\n    margin-top: 10px;\n  }\n  .scale-item {\n    flex: 1;\n    text-align: center;\n    font-size: 15px;\n    font-weight: 700;\n  }\n  .scale-item input { display: block; margin: 0 auto 4px; accent-color: #000000; }\n  .scale-ends {\n    display: flex;\n    justify-content: space-between;\n    font-size: 12px;\n    color: #888888;\n    margin-top: 4px;\n  }\n\n  table {\n    width: 90%;\n    margin: 0 auto;\n    border-collapse: collapse;\n    font-size: 14px;\n  }\n  th, td {\n    border: 1px solid #cccccc;\n    padding: 8px;\n    text-align: center;\n  }\n  th { background-color: #eee; }\n\n  .cta {\n    display: block;\n    width: 80%;\n    max-width: 320px;\n    margin: 30px auto;\n    text-align: center;\n    background-color: #000000;\n    color: #ffffff;\n    text-decoration: none;\n    font-weight: 700;\n    padding: 14px 0;\n    border-radius: 6px;\n    border: none;\n    font-size: 16px;\n    font-family: inherit;\n    cursor: pointer;\n  }\n  .cta:hover {\n    background-color: #d4af37;\n    color: #000;\n  }\n\n  .footer {\n    text-align: center;\n    font-size: 12px;\n    color: #888;\n    padding: 20px 10px;\n  }\n\n  @media only screen and (max-width: 480px) {\n    h1 { font-size: 20px; }\n    h2 { font-size: 18px; }\n    p  { margin: 12px 16px; font-size: 14px; }\n    .q-block { margin: 0 16px 4px; }\n    .cta { width: 90%; font-size: 14px; }\n    .scale-item { font-size: 13px; }\n  }\n</style>\n\n  <div class=\"container\">\n\n    <!-- Hero 圖片：放 X1 METAL 主視覺（請替換為正式商品圖網址）-->\n    <img src=\"https://img.1shop.tw/dmLqpoYEVREYo9xRbZy2XK7l/a1A4ovQm3KXP8GQLlDxz6OWE/original.jpg\" alt=\"Matrix X1 METAL 等離子便攜式電動磨豆機\" class=\"hero\">\n\n    <h1>【搶先一步】Matrix X1 METAL 等離子磨豆機<br>早鳥預購前測問卷</h1>\n    <p class=\"lead\">花 2 分鐘分享你的想法，搶先解鎖最優惠的早鳥價</p>\n\n    <p>嗨，謝謝你點進來 👋 Matrix 是一個專注咖啡器具的台灣品牌，我們即將推出一款全新磨豆機——<b>X1 METAL 等離子便攜式電動磨豆機</b>，在正式開賣前，想先聽聽不同使用者最真實的想法。</p>\n    <p>無論你是天天手沖的老玩家，還是剛開始喝咖啡、甚至還沒買過磨豆機，都歡迎填寫——沒有標準答案，誠實作答對我們最有幫助。</p>\n    <p>問卷只需要 <b>約 2 分鐘</b>，你的每一個回答都會直接影響我們的<b>定價、贈品與開賣方式</b>。完成填寫的人，將優先收到<b>早鳥預購通知與專屬優惠</b>。</p>\n\n    <!-- ── 商品介紹 ── -->\n    <div class=\"section-gray\">\n      <h2>先認識一下 X1 METAL</h2>\n      <p>X1 METAL 是一台<b>金屬機身的便攜式電動磨豆機</b>，採鋁合金與不鏽鋼打造，內建 1800mAh 鋰電池、Type-C 充電，淨重約 1060g、機身小巧（101×65×185mm），帶著走也順手。</p>\n      <p>它最大的亮點，是搭載<b>等離子（Plasma）技術</b>：簡單說，磨豆時咖啡粉常因靜電而結塊、亂飛、黏在杯壁上，等離子能<b>主動降低靜電與結塊</b>，讓粉末更鬆散、出粉口更乾淨，磁吸接粉杯也能輕鬆對位、不沾杯壁。</p>\n      <p>再加上<b>75 段研磨刻度</b>（也就是粗細可以微調 75 種程度），從濃縮（義式）、摩卡壺、手沖到法式濾壓都能精準對應，無論新手或老玩家都能找到自己那一杯。</p>\n      <img src=\"https://img.1shop.tw/dmLqpoYEVREYo9xRbZy2XK7l/7QBw2oEnYzJvOadpYxAP0vM9/original.png\" alt=\"X1 METAL 75 段研磨刻度調節示意圖\" class=\"figure\">\n      <p class=\"figure-cap\">▲ 轉動旋鈕即可在 75 段刻度間微調粗細</p>\n    </div>\n\n    <!-- 規格速覽，延續電子報的對照表風格 -->\n    <h2>30 秒看懂 X1 METAL</h2>\n    <table>\n      <tr><th>特色</th><th>X1 METAL</th></tr>\n      <tr><td>抗結塊 / 飛粉</td><td>等離子技術，主動降低靜電與結塊</td></tr>\n      <tr><td>研磨刻度</td><td>75 段微調，涵蓋義式～法式濾壓</td></tr>\n      <tr><td>機身材質</td><td>鋁合金 + 不鏽鋼，金屬質感</td></tr>\n      <tr><td>電力 / 充電</td><td>1800mAh 鋰電池．Type-C 充電</td></tr>\n      <tr><td>接粉設計</td><td>磁吸接粉杯，好對位、好收納</td></tr>\n      <tr><td>容量 / 重量</td><td>單次約 20–25g．淨重約 1060g</td></tr>\n    </table>\n\n    <!-- =========================================================\n         問卷主體\n         ========================================================= -->\n\n    <h2>關於你的咖啡習慣</h2>\n\n    <!-- Q1 經驗 -->\n    <div class=\"q-block\">\n      <span class=\"q-num\">Q1</span>\n      <p class=\"q-title\">你目前的咖啡沖煮經驗大約是？</p>\n      <p class=\"q-note\">單選</p>\n      <div class=\"opt\"><input type=\"radio\" id=\"q1a\" name=\"q1\" value=\"剛入門，還在嘗試階段\"><label for=\"q1a\">剛入門，還在嘗試階段</label></div>\n      <div class=\"opt\"><input type=\"radio\" id=\"q1b\" name=\"q1\" value=\"沖了一陣子，想沖得更穩定\"><label for=\"q1b\">沖了一陣子，想沖得更穩定</label></div>\n      <div class=\"opt\"><input type=\"radio\" id=\"q1c\" name=\"q1\" value=\"進階玩家，喜歡調整研磨與萃取參數\"><label for=\"q1c\">進階玩家，喜歡調整研磨與萃取參數</label></div>\n      <div class=\"opt\"><input type=\"radio\" id=\"q1d\" name=\"q1\" value=\"幾乎不自己沖，多半買現成\"><label for=\"q1d\">幾乎不自己沖，多半買現成</label></div>\n    </div>\n\n    <!-- Q2 沖煮方式 -->\n    <div class=\"q-block\">\n      <span class=\"q-num\">Q2</span>\n      <p class=\"q-title\">你平常主要用哪些方式沖咖啡？</p>\n      <p class=\"q-note\">可複選</p>\n      <div class=\"opt\"><input type=\"checkbox\" id=\"q2a\" name=\"q2\" value=\"手沖\"><label for=\"q2a\">手沖</label></div>\n      <div class=\"opt\"><input type=\"checkbox\" id=\"q2b\" name=\"q2\" value=\"義式 / 半自動咖啡機\"><label for=\"q2b\">義式 / 半自動咖啡機</label></div>\n      <div class=\"opt\"><input type=\"checkbox\" id=\"q2c\" name=\"q2\" value=\"摩卡壺\"><label for=\"q2c\">摩卡壺</label></div>\n      <div class=\"opt\"><input type=\"checkbox\" id=\"q2d\" name=\"q2\" value=\"法式濾壓 / 浸泡式\"><label for=\"q2d\">法式濾壓 / 浸泡式</label></div>\n      <div class=\"opt\"><input type=\"checkbox\" id=\"q2e\" name=\"q2\" value=\"其他\"><label for=\"q2e\">其他：<input type=\"text\" id=\"q2_other\" class=\"inline-text\" placeholder=\"請填寫\"></label></div>\n    </div>\n\n    <!-- Q3 現有磨豆方式 -->\n    <div class=\"q-block\">\n      <span class=\"q-num\">Q3</span>\n      <p class=\"q-title\">你現在都怎麼磨豆？</p>\n      <p class=\"q-note\">單選</p>\n      <div class=\"opt\"><input type=\"radio\" id=\"q3a\" name=\"q3\" value=\"用手搖磨豆機\"><label for=\"q3a\">用手搖磨豆機</label></div>\n      <div class=\"opt\"><input type=\"radio\" id=\"q3b\" name=\"q3\" value=\"用電動磨豆機\"><label for=\"q3b\">用電動磨豆機</label></div>\n      <div class=\"opt\"><input type=\"radio\" id=\"q3c\" name=\"q3\" value=\"請咖啡店 / 賣場代磨\"><label for=\"q3c\">請咖啡店 / 賣場代磨</label></div>\n      <div class=\"opt\"><input type=\"radio\" id=\"q3d\" name=\"q3\" value=\"直接買磨好的咖啡粉\"><label for=\"q3d\">直接買磨好的咖啡粉</label></div>\n    </div>\n\n    <!-- Q4 飛粉痛點 -->\n    <div class=\"q-block\">\n      <span class=\"q-num\">Q4</span>\n      <p class=\"q-title\">磨豆時，你會被「靜電飛粉、咖啡粉結塊沾杯」困擾嗎？</p>\n      <p class=\"q-note\">單選．這正是 X1 METAL 等離子技術想解決的問題</p>\n      <div class=\"opt\"><input type=\"radio\" id=\"q4a\" name=\"q4\" value=\"很困擾，每次都黏一堆粉、難清\"><label for=\"q4a\">很困擾，每次都黏一堆粉、難清</label></div>\n      <div class=\"opt\"><input type=\"radio\" id=\"q4b\" name=\"q4\" value=\"偶爾會，還能接受\"><label for=\"q4b\">偶爾會，還能接受</label></div>\n      <div class=\"opt\"><input type=\"radio\" id=\"q4c\" name=\"q4\" value=\"幾乎沒注意過這件事\"><label for=\"q4c\">幾乎沒注意過這件事</label></div>\n    </div>\n\n    <h2>關於 X1 METAL 這款新品</h2>\n\n    <!-- Q5 吸引力 1–5 -->\n    <div class=\"q-block\">\n      <span class=\"q-num\">Q5</span>\n      <p class=\"q-title\">看完介紹，X1 METAL 對你的吸引力有多高？</p>\n      <p class=\"q-note\">1 = 完全不吸引我　5 = 非常想要</p>\n      <div class=\"scale\">\n        <div class=\"scale-item\"><input type=\"radio\" name=\"q5\" value=\"1\">1</div>\n        <div class=\"scale-item\"><input type=\"radio\" name=\"q5\" value=\"2\">2</div>\n        <div class=\"scale-item\"><input type=\"radio\" name=\"q5\" value=\"3\">3</div>\n        <div class=\"scale-item\"><input type=\"radio\" name=\"q5\" value=\"4\">4</div>\n        <div class=\"scale-item\"><input type=\"radio\" name=\"q5\" value=\"5\">5</div>\n      </div>\n      <div class=\"scale-ends\"><span>完全不吸引</span><span>非常想要</span></div>\n    </div>\n\n    <!-- Q6 最打動的賣點 -->\n    <div class=\"q-block\">\n      <span class=\"q-num\">Q6</span>\n      <p class=\"q-title\">哪一個特色最打動你？</p>\n      <p class=\"q-note\">可複選，最多 2 項</p>\n      <div class=\"opt\"><input type=\"checkbox\" id=\"q6a\" name=\"q6\" value=\"等離子降低結塊與靜電飛粉\"><label for=\"q6a\">等離子降低結塊與靜電飛粉</label></div>\n      <div class=\"opt\"><input type=\"checkbox\" id=\"q6b\" name=\"q6\" value=\"75 段研磨刻度，多種沖法都適用\"><label for=\"q6b\">75 段研磨刻度，多種沖法都適用</label></div>\n      <div class=\"opt\"><input type=\"checkbox\" id=\"q6c\" name=\"q6\" value=\"金屬機身質感、可攜帶\"><label for=\"q6c\">金屬機身質感、可攜帶</label></div>\n      <div class=\"opt\"><input type=\"checkbox\" id=\"q6d\" name=\"q6\" value=\"內建鋰電池、Type-C 充電免插座\"><label for=\"q6d\">內建鋰電池、Type-C 充電免插座</label></div>\n      <div class=\"opt\"><input type=\"checkbox\" id=\"q6e\" name=\"q6\" value=\"磁吸接粉杯，好對位好清潔\"><label for=\"q6e\">磁吸接粉杯，好對位好清潔</label></div>\n    </div>\n\n    <!-- Q7 疑慮 -->\n    <div class=\"q-block\">\n      <span class=\"q-num\">Q7</span>\n      <p class=\"q-title\">在考慮購買時，你最在意或最猶豫的是什麼？</p>\n      <p class=\"q-note\">可複選</p>\n      <div class=\"opt\"><input type=\"checkbox\" id=\"q7a\" name=\"q7\" value=\"價格\"><label for=\"q7a\">價格</label></div>\n      <div class=\"opt\"><input type=\"checkbox\" id=\"q7b\" name=\"q7\" value=\"研磨均勻度、好不好用\"><label for=\"q7b\">研磨均勻度、好不好用</label></div>\n      <div class=\"opt\"><input type=\"checkbox\" id=\"q7c\" name=\"q7\" value=\"電動磨豆的續航與充電\"><label for=\"q7c\">電動磨豆的續航與充電</label></div>\n      <div class=\"opt\"><input type=\"checkbox\" id=\"q7d\" name=\"q7\" value=\"清潔保養是否麻煩\"><label for=\"q7d\">清潔保養是否麻煩</label></div>\n      <div class=\"opt\"><input type=\"checkbox\" id=\"q7e\" name=\"q7\" value=\"家裡已有磨豆機\"><label for=\"q7e\">家裡已有磨豆機</label></div>\n      <div class=\"opt\"><input type=\"checkbox\" id=\"q7f\" name=\"q7\" value=\"其他\"><label for=\"q7f\">其他：<input type=\"text\" id=\"q7_other\" class=\"inline-text\" placeholder=\"請填寫\"></label></div>\n    </div>\n\n    <h2>關於價格與預購</h2>\n\n    <!-- Q8 願付價格 -->\n    <div class=\"q-block\">\n      <span class=\"q-num\">Q8</span>\n      <p class=\"q-title\">在不打折的情況下，你覺得 X1 METAL 合理的價格大約是？</p>\n      <p class=\"q-note\">單選</p>\n      <div class=\"opt\"><input type=\"radio\" id=\"q8a\" name=\"q8\" value=\"NT$2,000 以下\"><label for=\"q8a\">NT$2,000 以下</label></div>\n      <div class=\"opt\"><input type=\"radio\" id=\"q8b\" name=\"q8\" value=\"NT$2,000 – 2,999\"><label for=\"q8b\">NT$2,000 – 2,999</label></div>\n      <div class=\"opt\"><input type=\"radio\" id=\"q8c\" name=\"q8\" value=\"NT$3,000 – 3,999\"><label for=\"q8c\">NT$3,000 – 3,999</label></div>\n      <div class=\"opt\"><input type=\"radio\" id=\"q8d\" name=\"q8\" value=\"NT$4,000 – 4,999\"><label for=\"q8d\">NT$4,000 – 4,999</label></div>\n      <div class=\"opt\"><input type=\"radio\" id=\"q8e\" name=\"q8\" value=\"NT$5,000 以上\"><label for=\"q8e\">NT$5,000 以上</label></div>\n    </div>\n\n    <!-- Q9 購買意願 -->\n    <div class=\"q-block\">\n      <span class=\"q-num\">Q9</span>\n      <p class=\"q-title\">如果開出早鳥優惠價，你會考慮預購嗎？</p>\n      <p class=\"q-note\">單選</p>\n      <div class=\"opt\"><input type=\"radio\" id=\"q9a\" name=\"q9\" value=\"會，已經很想入手\"><label for=\"q9a\">會，已經很想入手</label></div>\n      <div class=\"opt\"><input type=\"radio\" id=\"q9b\" name=\"q9\" value=\"看價格與贈品再決定\"><label for=\"q9b\">看價格與贈品再決定</label></div>\n      <div class=\"opt\"><input type=\"radio\" id=\"q9c\" name=\"q9\" value=\"想等開賣後看評價\"><label for=\"q9c\">想等開賣後看評價</label></div>\n      <div class=\"opt\"><input type=\"radio\" id=\"q9d\" name=\"q9\" value=\"暫時沒有需求\"><label for=\"q9d\">暫時沒有需求</label></div>\n    </div>\n\n    <!-- Q10 最有效的早鳥誘因 -->\n    <div class=\"q-block\">\n      <span class=\"q-num\">Q10</span>\n      <p class=\"q-title\">哪一種早鳥優惠最能讓你下單？</p>\n      <p class=\"q-note\">單選</p>\n      <div class=\"opt\"><input type=\"radio\" id=\"q10a\" name=\"q10\" value=\"直接折扣（折數越低越好）\"><label for=\"q10a\">直接折扣（折數越低越好）</label></div>\n      <div class=\"opt\"><input type=\"radio\" id=\"q10b\" name=\"q10\" value=\"加贈耗材 / 配件\"><label for=\"q10b\">加贈耗材 / 配件（如清潔刷、咖啡豆、收納袋）</label></div>\n      <div class=\"opt\"><input type=\"radio\" id=\"q10c\" name=\"q10\" value=\"點數回饋加倍\"><label for=\"q10c\">點數回饋加倍</label></div>\n      <div class=\"opt\"><input type=\"radio\" id=\"q10d\" name=\"q10\" value=\"限量贈品 / 獨家配色\"><label for=\"q10d\">限量贈品 / 獨家配色</label></div>\n    </div>\n\n    <!-- Q11 開放回饋 -->\n    <div class=\"q-block\">\n      <span class=\"q-num\">Q11</span>\n      <p class=\"q-title\">關於 X1 METAL 或這次預購，還有什麼想對 Matrix 說的嗎？</p>\n      <p class=\"q-note\">選填</p>\n      <textarea id=\"q11\" rows=\"3\" placeholder=\"你的建議是我們最重要的參考 ☕\"></textarea>\n    </div>\n\n    <!-- 信箱蒐集 -->\n    <div class=\"section-gray\">\n      <h2>留下信箱，搶先收到早鳥通知</h2>\n      <p style=\"text-align:center;\">完成問卷的人，將<b>優先收到預購開放通知與專屬優惠碼</b>。</p>\n      <div class=\"q-block\" style=\"border-bottom:none;\">\n        <p class=\"q-title\">電子信箱 / 會員手機</p>\n        <input type=\"email\" id=\"email\" placeholder=\"example@mail.com\">\n      </div>\n    </div>\n\n    <!-- 送出 -->\n    <button type=\"button\" id=\"submitBtn\" class=\"cta\">送出問卷，解鎖早鳥資格 →</button>\n    <p id=\"formStatus\" style=\"text-align:center; font-size:14px; margin:0 24px 10px; display:none;\"></p>\n\n    <div class=\"footer\">\n      Matrix 生活美學專家 © 2025 All Rights Reserved\n    </div>\n\n    <!-- Footer 區塊 -->\n    <div style=\"background-color:#f6f6f6; color:#ffffff; text-align:center; padding:30px 20px; border-radius:0 0 12px 12px;\">\n      <img src=\"https://img.1shop.tw/dmLqpoYEVREYo9xRbZy2XK7l/EM7nvrbJlqVMRVM0NBpxVwjP/600x.png\" alt=\"Matrix Logo\" style=\"width:80px; margin-bottom:10px;\">\n      <p style=\"font-size:14px; margin:4px 0; color:#000000;\">生活美學專家｜讓每一杯咖啡都是完美體驗</p>\n      <p style=\"font-size:13px; color:#4b5563; margin-top:8px;\">\n        追蹤我們：\n        <a href=\"https://www.facebook.com/matrixscale.tw\" target=\"_blank\" style=\"color:#334155; text-decoration:none;\">Facebook</a> |\n        <a href=\"https://www.instagram.com/matrix.tw\" target=\"_blank\" style=\"color:#334155; text-decoration:none;\">Instagram</a> |\n        <a href=\"https://www.threads.net/@matrix.tw\" target=\"_blank\" style=\"color:#334155; text-decoration:none;\">Threads</a>\n      </p>\n    </div>\n\n  </div>\n\n  <script>\n    // ⬇⬇⬇ 把這裡換成你部署 Apps Script 後拿到的「網頁應用程式網址」 ⬇⬇⬇\n    var SCRIPT_URL = \"https://script.google.com/macros/s/AKfycbxdZljBelSTlLyQuZ04ytBDVJQXNWBSqVZ19AestJzl75jJ09aEnAeSpk5aVM42n6BjcA/exec\";\n\n    var btn    = document.getElementById('submitBtn');\n    var status = document.getElementById('formStatus');\n\n    // 防呆：若嵌入網站時 formStatus 元素沒被一起貼上，動態補一個，避免 showStatus 崩潰\n    if (!status && btn) {\n      status = document.createElement('p');\n      status.id = 'formStatus';\n      status.style.textAlign = 'center';\n      status.style.fontSize = '14px';\n      status.style.margin = '0 24px 10px';\n      status.style.display = 'none';\n      btn.parentNode.insertBefore(status, btn.nextSibling);\n    }\n\n    // 取單選 / 量表的值\n    function getRadio(name) {\n      var el = document.querySelector('input[name=\"' + name + '\"]:checked');\n      return el ? el.value : '';\n    }\n\n    // 取複選的值（含「其他」自填內容）\n    function getChecks(name, otherId) {\n      var els = document.querySelectorAll('input[name=\"' + name + '\"]:checked');\n      var vals = [];\n      els.forEach(function (el) {\n        if (el.value === '其他' && otherId) {\n          var otherEl = document.getElementById(otherId);\n          var t = otherEl ? otherEl.value.trim() : '';\n          vals.push(t ? '其他：' + t : '其他');\n        } else {\n          vals.push(el.value);\n        }\n      });\n      return vals.join('、');\n    }\n\n    function showStatus(msg, color) {\n      if (!status) { alert(msg); return; }\n      status.textContent = msg;\n      status.style.color = color;\n      status.style.display = 'block';\n    }\n\n    btn.addEventListener('click', function () {\n      // 基本必填檢查：吸引力(Q5)、購買意願(Q9)、Email\n      var email = document.getElementById('email').value.trim();\n      if (!getRadio('q5') || !getRadio('q9')) {\n        showStatus('麻煩完成 Q5 與 Q9 兩題，再送出 🙏', '#c0392b');\n        return;\n      }\n      if (!email) {\n        showStatus('請留下 Email 或手機，才能寄送早鳥通知喔 📩', '#c0392b');\n        return;\n      }\n\n      var payload = {\n        q1:  getRadio('q1'),\n        q2:  getChecks('q2', 'q2_other'),\n        q3:  getRadio('q3'),\n        q4:  getRadio('q4'),\n        q5:  getRadio('q5'),\n        q6:  getChecks('q6'),\n        q7:  getChecks('q7', 'q7_other'),\n        q8:  getRadio('q8'),\n        q9:  getRadio('q9'),\n        q10: getRadio('q10'),\n        q11: document.getElementById('q11').value.trim(),\n        email: email\n      };\n\n      btn.disabled = true;\n      btn.textContent = '送出中…';\n      showStatus('正在送出，請稍候…', '#555');\n\n      // 用 no-cors 送出：瀏覽器不會擋跨網域寫入，但也讀不到回應內容，\n      // 因此送出後直接視為成功（Apps Script 端仍會正常寫入試算表）。\n      fetch(SCRIPT_URL, {\n        method: 'POST',\n        mode: 'no-cors',\n        headers: { 'Content-Type': 'text/plain;charset=utf-8' },\n        body: JSON.stringify(payload)\n      })\n      .then(function () {\n        btn.style.display = 'none';\n        showStatus('✅ 已收到你的回覆，謝謝！早鳥通知開放時會優先通知你。', '#1a7f37');\n      })\n      .catch(function (err) {\n        btn.disabled = false;\n        btn.textContent = '送出問卷，解鎖早鳥資格 →';\n        showStatus('送出失敗，請稍後再試一次 🙏（' + err.message + '）', '#c0392b');\n      });\n    });\n  </script>\n",
